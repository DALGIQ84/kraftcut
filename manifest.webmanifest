{
  "name": "KRAFTCUT",
  "short_name": "KRAFTCUT",
  "description": "Програма за разкрой на плоскости — М Плюс Мебели",
  "lang": "bg",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E9EDEF",
  "theme_color": "#F2B11F",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Разкрой KRAFTCUT",
      "accept": {
        "application/x-kraftcut": [
          ".kcut"
        ]
      },
      "icons": [
        {
          "src": "file-icon-16.png",
          "sizes": "16x16",
          "type": "image/png"
        },
        {
          "src": "file-icon-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "file-icon-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "file-icon-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "file-icon-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "file-icon-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}